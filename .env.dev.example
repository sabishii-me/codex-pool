# Copy this file to .env.dev. The resulting file is ignored by Git.
# Start Compose with: docker compose --env-file .env.dev -p codex-pool-dev -f docker-compose.dev.yml up -d --build

# Register this exact callback on a separate Google OAuth web client. Using
# 127.0.0.1 keeps its host-only cookies separate from a production dashboard
# opened at localhost.
# Every key is DEV_-prefixed so the development Compose file cannot silently
# inherit the equivalent production value from the repository's root .env.
DEV_OAUTH_GOOGLE_CLIENT_ID=
DEV_OAUTH_GOOGLE_CLIENT_SECRET=
DEV_OAUTH_GOOGLE_REDIRECT_URI=http://127.0.0.1:18990/auth/callback/google
DEV_PUBLIC_URL=http://127.0.0.1:18990

# Enables the current React UI with an isolated synthetic member session.
# The server rejects this mode unless PUBLIC_URL and the request host are loopback.
DEV_LOCAL_SESSION=true

# Login is denied when this is empty. DEV_ADMIN_EMAILS requires exact addresses.
DEV_ALLOWED_EMAILS=you@example.com
DEV_ADMIN_EMAILS=you@example.com

# Generate a separate value; do not reuse the production secret.
# Example: openssl rand -hex 32
DEV_POOL_JWT_SECRET=replace-with-a-development-only-random-secret

# Runtime provider specifications are mounted from ./dev/provider-specs into
# the isolated container. Copy examples there only when testing hot reload:
#   mkdir -p dev/provider-specs
#   cp provider-specs.example/deepseek.json dev/provider-specs/

DEV_FRIEND_NAME=Codex Pool Dev
DEV_PROXY_DEBUG=false
DEV_PROXY_MAX_ATTEMPTS=1

# Keep refresh disabled for fixture/snapshot credentials. Enable it only when
# intentionally testing a real provider connection owned by the dev instance.
DEV_PROXY_DISABLE_REFRESH=true
