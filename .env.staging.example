# Copy to .env.staging (ignored by Git) only when overriding defaults.
# Start with:
# docker compose --env-file .env.staging -p codex-pool-staging -f docker-compose.staging.yml up -d

# Keep this pinned to a validated immutable tag. Never use codex-pool:dev/latest.
STAGING_IMAGE=codex-pool:staging-a91560b
STAGING_PUBLIC_URL=http://127.0.0.1:18990
STAGING_LOCAL_SESSION=true
STAGING_POOL_JWT_SECRET=replace-with-a-staging-only-random-secret
STAGING_FRIEND_NAME=Codex Pool Staging
STAGING_PROXY_DEBUG=false
STAGING_PROXY_MAX_ATTEMPTS=1
STAGING_PROXY_DISABLE_REFRESH=true

# Configure only when explicitly testing production-style authentication.
STAGING_OAUTH_GOOGLE_CLIENT_ID=
STAGING_OAUTH_GOOGLE_CLIENT_SECRET=
STAGING_OAUTH_GOOGLE_REDIRECT_URI=http://127.0.0.1:18990/auth/callback/google
STAGING_ALLOWED_EMAILS=
STAGING_ADMIN_EMAILS=
