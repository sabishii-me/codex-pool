# Copy to .env.staging.local (ignored by Git).
# Start with:
# docker compose --env-file .env.staging.local -p codex-pool-staging -f docker-compose.staging.yml up -d

# Required: exact immutable image promoted from Test. Never use dev/latest.
STAGING_IMAGE=codex-pool:staging-<commit>
STAGING_PUBLIC_URL=http://127.0.0.1:18990

STAGING_OAUTH_GOOGLE_CLIENT_ID=
STAGING_OAUTH_GOOGLE_CLIENT_SECRET=
STAGING_OAUTH_GOOGLE_REDIRECT_URI=http://127.0.0.1:18990/auth/callback/google
STAGING_ALLOWED_EMAILS=you@example.com
STAGING_ADMIN_EMAILS=you@example.com
STAGING_POOL_JWT_SECRET=replace-with-a-staging-secret

STAGING_FRIEND_NAME=Codex Pool Staging
