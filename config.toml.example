# Codex Pool Proxy Configuration
# Copy this file to config.toml and customize as needed.
# Environment variables take precedence over config file values.

# Server settings
listen_addr = "127.0.0.1:8989"
pool_dir = "pool"
db_path = "./data/proxy.db"
max_attempts = 3
# Max request body size to buffer in memory before streaming (bytes).
# Set via env PROXY_MAX_INMEM_BODY_BYTES (default 16777216).

# Public URL for generated configs and instructions
# Use this when behind a reverse proxy or using a custom domain
# Example: "https://proxy.example.com" or "http://192.168.1.100:8989"
public_url = ""

# Grok Code upstream and accounts
# Accounts are loaded from pool/grok/*.json. You can paste/import ~/.grok auth JSON
# from the friend admin page, or place pi-grok/simple auth JSON in that directory.
grok_base = "https://cli-chat-proxy.grok.com/v1"

# Google OAuth Access Gate
# Enable a "Sign in with Google" landing page at / for the pool dashboard.
# Register a Web application OAuth client in Google Cloud Console with
# redirect URI <public_url>/auth/callback/google and scopes openid email profile.
# Only verified emails in allowed_emails may sign in - an empty list denies everyone.
# Entries with no "@" are treated as a bare domain and match any address on
# that domain (e.g. "example.com" allows anyone@example.com).
oauth_google_client_id = ""
oauth_google_client_secret = ""
allowed_emails = ["you@example.com", "your-domain.com"]

# Operator/admin access (account enable/disable, provider admin routes,
# /metrics, etc.). Requires signing in above AND setting up two-factor
# authentication (TOTP, prompted on first admin sign-in) - unlike
# allowed_emails, this is exact-match only, no bare-domain entries: granting
# operator power to a whole domain is a much bigger blast radius than just
# letting the domain sign in.
admin_emails = ["you@example.com"]

# Pool Users (Multi-User Mode)
# Enable this section to allow creating users who can share the pool
# without access to real account credentials.
[pool_users]
# Secret key for signing pool user tokens (should be 32+ characters)
jwt_secret = ""

# Where to store pool user data
storage_path = "./data/pool_users.json"

# Optional model name aliases (short name -> upstream model).
# Built-in defaults always include: gpt-5.6 -> gpt-5.6-sol
# Entries here override built-ins.
# [model_aliases]
# "gpt-5.6" = "gpt-5.6-sol"
