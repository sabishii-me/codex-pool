{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-pool.local/schemas/provider-connections-v2.json",
  "title": "Provider Connections V2",
  "type": "array",
  "items": { "$ref": "#/$defs/OperatorProviderConnectionV2" },
  "$defs": {
    "ProviderConnectionIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_name"],
      "properties": {
        "display_name": { "type": "string" },
        "external_subject": { "type": "string" },
        "attributes": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "ProviderConnectionRuntimeView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["healthy", "degraded", "cooldown", "disabled", "dead", "verification_required"] },
        "status_detail": { "type": "string" },
        "rate_limit_until": { "type": "string", "format": "date-time" },
        "primary_used_percent": { "type": "number" },
        "primary_window_minutes": { "type": "integer" },
        "primary_reset_at": { "type": "string", "format": "date-time" },
        "secondary_used_percent": { "type": "number" },
        "secondary_window_minutes": { "type": "integer" },
        "secondary_reset_at": { "type": "string", "format": "date-time" },
        "usage_retrieved_at": { "type": "string", "format": "date-time" },
        "usage_source": { "type": "string" }
      }
    },
    "OperatorProviderConnectionV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "public_id", "provider_id", "identity", "disabled", "dead", "inflight", "penalty", "score", "is_primary", "runtime", "reset_credits", "usage", "totals"],
      "properties": {
        "id": { "type": "string" },
        "public_id": { "type": "string" },
        "provider_id": { "type": "string" },
        "identity": { "$ref": "#/$defs/ProviderConnectionIdentity" },
        "plan_type": { "type": "string" },
        "disabled": { "type": "boolean" },
        "dead": { "type": "boolean" },
        "needs_verification": { "type": "boolean" },
        "verification_url": { "type": "string" },
        "health_error": { "type": "string" },
        "cyber_access": { "type": "boolean" },
        "inflight": { "type": "integer" },
        "expires_at": { "type": "string", "format": "date-time" },
        "last_refresh": { "type": "string", "format": "date-time" },
        "penalty": { "type": "number" },
        "score": { "type": "number" },
        "score_tooltip": { "type": "string" },
        "is_primary": { "type": "boolean" },
        "runtime": { "$ref": "#/$defs/ProviderConnectionRuntimeView" },
        "credit_balance": { "type": "number" },
        "credit_retrieved_at": { "type": "string", "format": "date-time" },
        "reset_credits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["known", "available_count", "expirations", "management_available", "inventory_refresh_available", "redemption_available", "dashboard_url"],
          "properties": {
            "known": { "type": "boolean" },
            "available_count": { "type": "integer" },
            "expirations": { "type": "array", "items": { "type": "string", "format": "date-time" } },
            "retrieved_at": { "type": "string", "format": "date-time" },
            "management_available": { "type": "boolean" },
            "inventory_refresh_available": { "type": "boolean" },
            "redemption_available": { "type": "boolean" },
            "dashboard_url": { "type": "string", "format": "uri" }
          }
        },
        "usage": { "type": "object", "additionalProperties": true },
        "totals": { "type": "object", "additionalProperties": { "type": "number" } }
      }
    }
  }
}
