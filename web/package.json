{
  "name": "codex-pool-signal-room",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:api-types": "node scripts/generate-api-types.mjs",
    "build": "npm run generate:api-types && tsc -b && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:baseline": "playwright test tests/e2e/legacy-baseline.spec.ts",
    "test:e2e:baseline:soak": "node scripts/run-baseline-soak.mjs",
    "design:serve": "product-design-harness serve --root ../.product-design",
    "design:doctor": "product-design-harness doctor --root ../.product-design",
    "design:validate": "product-design-harness validate --root ../.product-design",
    "design:validate:browser": "product-design-harness validate --root ../.product-design --browser",
    "design:capture": "product-design-harness capture --root ../.product-design"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.21",
    "clsx": "2.1.1",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "motion": "12.42.2",
    "qrcode": "^1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@sabishii/product-design-harness": "git+https://github.com/sabishii-me/product-design-harness.git#9c85b076f7cece3d910919403abf23764f4038df",
    "@tailwindcss/vite": "^4.3.2",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.1.7",
    "@types/node": "^26.1.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "tailwindcss": "^4.3.2",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "vitest": "4.1.2"
  }
}
